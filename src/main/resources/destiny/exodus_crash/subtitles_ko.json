{
  "lines": {
    "80b5c211": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c211",
      "seconds": 7.9418125,
      "speaker": "안전장치",
      "text": "스텔스 발전기? 이건 너무하네요! 함장님, 전기 구체로 빨리 태워버려요.",
      "ticks": 159,
      "voice": true
    },
    "80b5c213": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c213",
      "seconds": 3.357458333333333,
      "speaker": "고스트",
      "text": "전기 구체로 스텔스 발전기를 무력화할 수 있을 것 같아요.",
      "ticks": 68,
      "voice": true
    },
    "80b5c215": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c215",
      "seconds": 8.221916666666667,
      "speaker": "고스트",
      "text": "네소스는 유로파와 멀리 떨어져 있는데도 구원의 가문은 정찰대를 보냈어요. 가치가 있다고 생각한 게 분명해요.",
      "ticks": 165,
      "voice": true
    },
    "80b5c216": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c216",
      "seconds": 4.659541666666667,
      "speaker": "세인트-14",
      "text": "무작정 달려들지 마, 수호자! 우선은 스텔스 장을 무너뜨려.",
      "ticks": 94,
      "voice": true
    },
    "80b5c217": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c217",
      "seconds": 6.419520833333333,
      "speaker": "고스트",
      "text": "이 스텔스 장은 전기 에너지에 취약해요! 수호자, 혹시 저와 같은 생각을 하고 있나요?",
      "ticks": 129,
      "voice": true
    },
    "80b5c218": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c218",
      "seconds": 5.758583333333333,
      "speaker": "세인트-14",
      "text": "그렇다고 무기를 들고 나타날 필요는 없잖아. 안전장치, 괜찮나?",
      "ticks": 116,
      "voice": true
    },
    "80b5c219": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c219",
      "seconds": 3.0413958333333335,
      "speaker": "고스트",
      "text": "구원의 가문은 원하던 걸 찾았을까요?",
      "ticks": 61,
      "voice": true
    },
    "80b5c21a": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c21a",
      "seconds": 3.549354166666667,
      "speaker": "안전장치",
      "text": "정말이에요, 저도 해 봤거든요.",
      "ticks": 71,
      "voice": true
    },
    "80b5c21b": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c21b",
      "seconds": 3.8749166666666666,
      "speaker": "고스트",
      "text": "하지만, 네소스의 격변에 대해서는 어떻게 알았을까요?",
      "ticks": 78,
      "voice": true
    },
    "80b5c21c": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c21c",
      "seconds": 3.7138333333333335,
      "speaker": "세인트-14",
      "text": "그렇군. 도움이 필요하면 언제든 얘기하도록 해라.",
      "ticks": 75,
      "voice": true
    },
    "80b5c21d": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c21d",
      "seconds": 3.9116666666666666,
      "speaker": "안전장치",
      "text": "저 생명체 말고도 이미 문제가 많은데 말이죠.",
      "ticks": 79,
      "voice": true
    },
    "80b5c21f": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c21f",
      "seconds": 4.764833333333334,
      "speaker": "안전장치",
      "text": "행성 전체에 걸쳐 지각 활동을 숨기는 것은 거의 불가능해요.",
      "ticks": 96,
      "voice": true
    },
    "80b5c220": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c220",
      "seconds": 5.519645833333334,
      "speaker": "고스트",
      "text": "미안해요, 안전장치. 반갑지 않은 손님들이 당신을 찾아온 것 같아요.",
      "ticks": 111,
      "voice": true
    },
    "80b5c221": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c221",
      "seconds": 5.490083333333334,
      "speaker": "안전장치",
      "text": "하지만 당신과 함장님도 돌아왔군요. 잘됐네요.",
      "ticks": 110,
      "voice": true
    },
    "80b5c222": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c222",
      "seconds": 3.2350416666666666,
      "speaker": "세인트-14",
      "text": "이 엘릭스니들이 오래 머물지 않아야 할 텐데.",
      "ticks": 65,
      "voice": true
    },
    "80b5c224": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c224",
      "seconds": 7.4170625,
      "speaker": "안전장치",
      "text": "대부분의 생명체와 인공지능은 총소리보다는 침묵을 선호하죠. 수호자들은 특별히 예외지만요.",
      "ticks": 149,
      "voice": true
    },
    "80b5c225": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c225",
      "seconds": 3.6677708333333334,
      "speaker": "세인트-14",
      "text": "그렇진 않은 것 같다. 그랬다면 우리가 알았겠지.",
      "ticks": 74,
      "voice": true
    },
    "80b5c226": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c226",
      "seconds": 4.757208333333334,
      "speaker": "고스트",
      "text": "전력이 끊겼어요! 보이지가 않네.",
      "ticks": 96,
      "voice": true
    },
    "80b5c227": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c227",
      "seconds": 2.8371458333333335,
      "speaker": "고스트",
      "text": "잠깐만요, 우리 위쪽에 뭔가 있어요…",
      "ticks": 57,
      "voice": true
    },
    "80b5c228": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c228",
      "seconds": 4.3503125,
      "speaker": "세인트-14",
      "text": "아, 훨씬 낫군… 안전장치, 그렇지?",
      "ticks": 88,
      "voice": true
    },
    "80b5c229": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c229",
      "seconds": 1.066875,
      "speaker": "고스트",
      "text": "들었어요?",
      "ticks": 22,
      "voice": true
    },
    "80b5c22a": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c22a",
      "seconds": 1.6979583333333332,
      "speaker": "고스트",
      "text": "누가 있어요.",
      "ticks": 34,
      "voice": true
    },
    "80b5c22b": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c22b",
      "seconds": 2.647291666666667,
      "speaker": "세인트-14",
      "text": "우릴 너무 잘 안다니까.",
      "ticks": 53,
      "voice": true
    },
    "80b5c22c": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c22c",
      "seconds": 1.0812291666666667,
      "speaker": "고스트",
      "text": "뭐죠?",
      "ticks": 22,
      "voice": true
    },
    "80b5c22d": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c22d",
      "seconds": 3.4085833333333335,
      "speaker": "고스트",
      "text": "이 장치는 낡은 전기 에너지 전달체예요.",
      "ticks": 69,
      "voice": true
    },
    "80b5c22e": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c22e",
      "seconds": 3.094104166666667,
      "speaker": "고스트",
      "text": "바닥의 그물 같은 게 일종의 전기 전도체 같아요.",
      "ticks": 62,
      "voice": true
    },
    "80b5c230": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c230",
      "seconds": 3.6591458333333335,
      "speaker": "세인트-14",
      "text": "매복하기 딱 좋지. 경계심을 늦추지 마.",
      "ticks": 74,
      "voice": true
    },
    "80b5c231": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c231",
      "seconds": 4.324229166666667,
      "speaker": "고스트",
      "text": "으으… 여긴 정말 춥고 어둡네요.",
      "ticks": 87,
      "voice": true
    },
    "80b5c232": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c232",
      "seconds": 6.283458333333333,
      "speaker": "안전장치",
      "text": "근처에 보호막이 감지되고 있어요. 이 전기 구체와 관련된 것일 수도 있어요.",
      "ticks": 126,
      "voice": true
    },
    "80b5c233": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c233",
      "seconds": 2.9661666666666666,
      "speaker": "고스트",
      "text": "이 기계는... 전기 에너지 흡수 장치예요!",
      "ticks": 60,
      "voice": true
    },
    "80b5c234": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c234",
      "seconds": 7.1714375,
      "speaker": "세인트-14",
      "text": "흠, 벡스는 목적없인 움직이지 않지. 전기 구체로 뭔가에 동력을 공급하는 게 분명하다.",
      "ticks": 144,
      "voice": true
    },
    "80b5c235": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c235",
      "seconds": 4.734708333333334,
      "speaker": "고스트",
      "text": "그 구체를 가져와, 수호자. 그걸로 뭘 할 수 있을지 보자.",
      "ticks": 95,
      "voice": true
    },
    "80b5c236": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c236",
      "seconds": 2.2468541666666666,
      "speaker": "고스트",
      "text": "전기 에너지가 닿지 않게 해야겠어요.",
      "ticks": 45,
      "voice": true
    },
    "80b5c238": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c238",
      "seconds": 5.301229166666666,
      "speaker": "세인트-14",
      "text": "수호자, 엑소더스 블랙에 벡스와 구원의 가문 엘릭스니가 들끓고 있어.",
      "ticks": 107,
      "voice": true
    },
    "80b5c239": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c239",
      "seconds": 3.5095833333333335,
      "speaker": "안전장치",
      "text": "도대체 제가 뭘 잘못했길래 이러는 거죠?",
      "ticks": 71,
      "voice": true
    },
    "80b5c23d": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c23d",
      "seconds": 5.898083333333333,
      "speaker": "안전장치",
      "text": "함장님. 벡스와 구원의 가문이 엑소더스 블랙에 있는 걸 감지했어요.",
      "ticks": 118,
      "voice": true
    },
    "80b5c23e": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c23e",
      "seconds": 2.3800625,
      "speaker": "세인트-14",
      "text": "그래, 좋아— 나도야!",
      "ticks": 48,
      "voice": true
    },
    "80b5c23f": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c23f",
      "seconds": 4.4755416666666665,
      "speaker": "안전장치",
      "text": "이 행성은 절 괴롭히는 걸 정말 좋아하네요.",
      "ticks": 90,
      "voice": true
    },
    "80b5c240": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c240",
      "seconds": 4.477875,
      "speaker": "세인트-14",
      "text": "그런 말 하지 마. 모험이라고 생각해, 벡스를 때려 부수는 거야!",
      "ticks": 90,
      "voice": true
    },
    "80b5c241": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c241",
      "seconds": 3.3691666666666666,
      "speaker": "안전장치",
      "text": "…그것도 나쁘진 않네요.",
      "ticks": 68,
      "voice": true
    },
    "80b5c242": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c242",
      "seconds": 6.077770833333333,
      "speaker": "안전장치",
      "text": "그게 벡스를 끌어들인 것 같아요. 하지만 구원의 가문 군대는 왜 따라왔는지 모르겠네요.",
      "ticks": 122,
      "voice": true
    },
    "80b5c243": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c243",
      "seconds": 5.733770833333334,
      "speaker": "안전장치",
      "text": "제 가장 강력한 예측 모델에 따르면, 추락 지점 아래에서 지진 활동이 증가했어요.",
      "ticks": 115,
      "voice": true
    },
    "80b5c244": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c244",
      "seconds": 3.7335,
      "speaker": "세인트-14",
      "text": "수호자, 엑소더스 블랙에 벡스 무리가 침투했다.",
      "ticks": 75,
      "voice": true
    },
    "80b5c248": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c248",
      "seconds": 1.7775208333333334,
      "speaker": "세인트-14",
      "text": "수호자가 알아낼 수 있을 거야.",
      "ticks": 36,
      "voice": true
    },
    "80b5c249": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c249",
      "seconds": 8.273625,
      "speaker": "안전장치",
      "text": "엑소더스 블랙에 벡스가 들어왔어요. 그리고 몰락자들은 그들을 공격하며 네소스 전역에 우물을 파고 있고요!",
      "ticks": 166,
      "voice": true
    },
    "80b5c24a": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c24a",
      "seconds": 1.6915416666666667,
      "speaker": "세인트-14",
      "text": "아, 그건 아니고.",
      "ticks": 34,
      "voice": true
    },
    "80b5c24b": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c24b",
      "seconds": 1.8429583333333333,
      "speaker": "세인트-14",
      "text": "누구에게나 그런 날이 있지.",
      "ticks": 37,
      "voice": true
    },
    "80b5c24c": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c24c",
      "seconds": 2.474458333333333,
      "speaker": "세인트-14",
      "text": "걱정하지 마라. 우리가 해결할 테니.",
      "ticks": 50,
      "voice": true
    },
    "80b5c24f": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c24f",
      "seconds": 4.599541666666667,
      "speaker": "세인트-14",
      "text": "엘릭스니는 정찰병 같다. 벡스를 따라 추락 현장으로 들어간 것 같군.",
      "ticks": 92,
      "voice": true
    },
    "80b5c250": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c250",
      "seconds": 6.6621041666666665,
      "speaker": "안전장치",
      "text": "그럴 리가요. 제겐 즐거움 말고도 벡스를 파괴할 이유가 넘쳐나거든요.",
      "ticks": 134,
      "voice": true
    },
    "80b5c251": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c251",
      "seconds": 4.821208333333334,
      "speaker": "세인트-14",
      "text": "네가 이 구조 요청에 응답할 거라고 안전장치가 예상했는데, 그게 맞았군.",
      "ticks": 97,
      "voice": true
    },
    "80b5c252": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c252",
      "seconds": 4.269645833333334,
      "speaker": "안전장치",
      "text": "지금은요. 계속 괜찮을지는 모르지만요.",
      "ticks": 86,
      "voice": true
    },
    "80b5c253": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c253",
      "seconds": 4.882833333333333,
      "speaker": "안전장치",
      "text": "수학적으로 불가능하긴 하지만, 전 함장님을 150% 믿어요.",
      "ticks": 98,
      "voice": true
    },
    "80b5c256": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c256",
      "seconds": 2.1961875,
      "speaker": "고스트",
      "text": "제가 없는 동안 조심해요!",
      "ticks": 44,
      "voice": true
    },
    "80b5c257": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c257",
      "seconds": 2.8283958333333334,
      "speaker": "고스트",
      "text": "딱 붙어 있어요! 방벽을 내릴 테니까요.",
      "ticks": 57,
      "voice": true
    },
    "80b5c258": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c258",
      "seconds": 4.072416666666666,
      "speaker": "세인트-14",
      "text": "하! 너도 은근히 즐기는 것 같은데, 안전장치?",
      "ticks": 82,
      "voice": true
    },
    "80b5c259": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c259",
      "seconds": 1.1319166666666667,
      "speaker": "고스트",
      "text": "금방 올게요!",
      "ticks": 23,
      "voice": true
    },
    "80b5c25a": {
      "authored": false,
      "event": "destiny_exodus:voice.80b5c25a",
      "seconds": 4.261791666666666,
      "speaker": "안전장치",
