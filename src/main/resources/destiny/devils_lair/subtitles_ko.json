{
  "lines": {
    "80b59f1d": {
      "authored": false,
      "event": "destiny_devils:voice.80b59f1d",
      "seconds": 2.7163333333333335,
      "speaker": "고스트",
      "text": "끝내주네요. 탈출로가 봉쇄됐어요.",
      "ticks": 55,
      "voice": true
    },
    "80b59f1e": {
      "authored": false,
      "event": "destiny_devils:voice.80b59f1e",
      "seconds": 2.114625,
      "speaker": "고스트",
      "text": "잘했어요!",
      "ticks": 43,
      "voice": true
    },
    "80b59f1f": {
      "authored": false,
      "event": "destiny_devils:voice.80b59f1f",
      "seconds": 2.2861875,
      "speaker": "고스트",
      "text": "여기가 악마의 소굴이군요.",
      "ticks": 46,
      "voice": true
    },
    "80b59f20": {
      "authored": false,
      "event": "destiny_devils:voice.80b59f20",
      "seconds": 2.530625,
      "speaker": "고스트",
      "text": "더 빨리 할게요.",
      "ticks": 51,
      "voice": true
    },
    "80b59f21": {
      "authored": false,
      "event": "destiny_devils:voice.80b59f21",
      "seconds": 5.641416666666666,
      "speaker": "고스트",
      "text": "거의 다 됐어요. 혹시나 해서 하는 말인데, 몰락자와 군체가 더 접근하고 있어요.",
      "ticks": 113,
      "voice": true
    },
    "80b59f22": {
      "authored": false,
      "event": "destiny_devils:voice.80b59f22",
      "seconds": 5.267541666666666,
      "speaker": "고스트",
      "text": "몰락자와 군체라니. 십자 포화를 피할 수 있으면 좋겠네요.",
      "ticks": 106,
      "voice": true
    },
    "80b59f23": {
      "authored": false,
      "event": "destiny_devils:voice.80b59f23",
      "seconds": 5.414875,
      "speaker": "고스트",
      "text": "저기 앞쪽 식민지 우주선 아래에 소굴이 있어요. 저기… 악마들 반대쪽에요.",
      "ticks": 109,
      "voice": true
    },
    "80b59f24": {
      "authored": false,
      "event": "destiny_devils:voice.80b59f24",
      "seconds": 3.515229166666667,
      "speaker": "고스트",
      "text": "방벽이 해제됐어요. 이제 움직일 수 있어요.",
      "ticks": 71,
      "voice": true
    },
    "80b59f25": {
      "authored": false,
      "event": "destiny_devils:voice.80b59f25",
      "seconds": 6.218854166666667,
      "speaker": "고스트",
      "text": "몰락자가 점점 더 영리해지네요. 전체 시스템이 연결되어 있는 게—",
      "ticks": 125,
      "voice": true
    },
    "80b59f26": {
      "authored": false,
      "event": "destiny_devils:voice.80b59f26",
      "seconds": 2.9402708333333334,
      "speaker": "고스트",
      "text": "상당히 복잡하네요. 시간이 필요해요.",
      "ticks": 59,
      "voice": true
    },
    "80b59f27": {
      "authored": false,
      "event": "destiny_devils:voice.80b59f27",
      "seconds": 22.142,
      "speaker": "자발라",
      "text": "몰락자를 격퇴하지 않으면, 놈들은 끊임없이 우리 도시의 장벽을 파고들 걸세. 발사 기지의 폐허 아래, 옛 식민지 우주선의 그림자 속에서 악마의 가문 소굴과 그들에게 힘을 주는 상위 서비터의 위치를 확인했네. 기계 신을 파괴하고 그들의 영혼을 지옥으로 돌려보내야 하네.",
      "ticks": 443,
      "voice": true
    },
    "80b59f28": {
      "authored": false,
      "event": "destiny_devils:voice.80b59f28",
      "seconds": 18.225645833333335,
      "speaker": "자발라",
      "text": "세픽스 프라임이 도시에 거대한 그림자를 드리웠네. 그걸 파괴했으니 몰락자 악마들도 약해지겠지. 하지만 경계를 늦춰선 안 되네. 몰락자가 영악해지고 있어. 놈들은 생존할 방법을 찾아낼 걸세. 언제나 그렇듯이.",
      "ticks": 365,
      "voice": true
    }
  }
}
