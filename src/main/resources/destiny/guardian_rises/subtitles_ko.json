{
  "version": 1,
  "source": "Rising-Guardian-2026-11-01/dialogue-ko.csv (korean column, exact)",
  "lines": {
    "80b75f55": {
      "speaker": "고스트",
      "text": "움직여야 해요. 무기가 없으면 쉽게 당할 거예요.",
      "english": "We have to move. Without a weapon, we're easy prey.",
      "ticks": 73,
      "duration_sec": 3.6343,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F55.wav",
      "source_sha256": "bad5f3b6c802c79c0a1062635ca1afad9f731bbca8e4e7c9cdaa27e61d7a37ff",
      "output_sha256": "61b3170c563f60e23eef6537cc320988e9def95e72666284a1f3a551793f9c1f",
      "output_bytes": 40723
    },
    "80b75f52": {
      "speaker": "고스트",
      "text": "계속 싸워요! 전 근처 우주선을 스캔할게요.",
      "english": "Keep fighting! I'm scanning for nearby ships.",
      "ticks": 83,
      "duration_sec": 4.1188,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F52.wav",
      "source_sha256": "a34a48655fe7efa626e8d58aa5c00e0f4f953b2669602eb46c1ee80ce1067273",
      "output_sha256": "0b48da7bca8bd8deeb60a0f63e38d2d116e2822235435408a159320c0dd5c96d",
      "output_bytes": 47547
    },
    "80b75f50": {
      "speaker": "고스트",
      "text": "저기 소총이 있어요. 어서 잡아요!",
      "english": "There's a rifle. Grab it!",
      "ticks": 66,
      "duration_sec": 3.2763,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F50.wav",
      "source_sha256": "ce68e5ca37f0a5be52b6e9363caaf5cf377bc1e733567ad8669c3ca302879e85",
      "output_sha256": "d84d8c931d684924d3f20949bccfe009624343fd73b9f0c49f1430663afe97c4",
      "output_bytes": 39609
    },
    "80b75f54": {
      "speaker": "고스트",
      "text": "당신을 선택한 이유가 있어요, 수호자… 당신은 타이탄이에요. 투사란 뜻이죠.",
      "english": "I brought you back for a reason, Guardian. You're a Titan—that means you're a fighter.",
      "ticks": 135,
      "duration_sec": 6.7373,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F54.wav",
      "source_sha256": "8046359eb15b28947039aea3e5b422393bb34ea3676fab1b5a99fb121ea814a0",
      "output_sha256": "26ceabe225cab4cd7109adc1c357805a44bc5bbb2c9df50e0d8e0b02a78e4f52",
      "output_bytes": 74347
    },
    "80b75f53": {
      "speaker": "고스트",
      "text": "그러니 준비하세요. 여긴 적진 한가운데예요.",
      "english": "So be ready. 'Cause we're deep in enemy territory.",
      "ticks": 66,
      "duration_sec": 3.288,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F53.wav",
      "source_sha256": "7a2b9f1eece07750d1b0b3338946284bfbe8fc391644ecfbbca72822c4dba0ed",
      "output_sha256": "454fa68192ba0dca5d8fa69144069e2ff9fe121f15b29925871b68c2f7f3dc0f",
      "output_bytes": 39194
    },
    "80b75f56": {
      "speaker": "고스트",
      "text": "당신을 선택한 이유가 있어요, 수호자… 당신은 헌터예요. 위험을 감수할 줄 안다는 뜻이죠.",
      "english": "I brought you back for a reason, Guardian. You're a Hunter—that means you're not afraid to take risks.",
      "ticks": 165,
      "duration_sec": 8.2429,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F56.wav",
      "source_sha256": "6d29d2e6a908020ce78a38c30b5a697940c9ddd1023d117a1f69bd532069813b",
      "output_sha256": "cdfacd6f6f6412d779bd1b394a17a12d6538192d4ec91f4e4cb83b8d1b69fcc1",
      "output_bytes": 89520
    },
    "80b75f59": {
      "speaker": "고스트",
      "text": "그러니 계속 움직이세요. 싸움에 뛰어들 준비를 하세요.",
      "english": "So, keep moving and be ready for a fight.",
      "ticks": 91,
      "duration_sec": 4.5249,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F59.wav",
      "source_sha256": "3031a7f08d138b96d7be6dcdc63b92457d8c4a747f3127d6dc3f789549543789",
      "output_sha256": "e8b4a4ea0afd6b6ef378a93cf509271c8e984a1975baa898dba0ed031a18ca95",
      "output_bytes": 51617
    },
    "80b75f58": {
      "speaker": "고스트",
      "text": "당신을 선택한 이유가 있어요, 수호자… 당신은 워록이에요. 당신의 호기심은 그 어떤 무기보다 더 위험하죠.",
      "english": "I brought you back for a reason, Guardian. You're a Warlock. Your curiosity's as dangerous as any weapon.",
      "ticks": 186,
      "duration_sec": 9.2878,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F58.wav",
      "source_sha256": "85c072560730907c1af0cdc20a208bca671b67fd6d9fe2fdc7dc0cc86a2609b5",
      "output_sha256": "01a6dc690cef3c1295241b2efcc49b6c8052fa3c0a46d56d1ebbb65a84f806a0",
      "output_bytes": 98566
    },
    "80b75f5e": {
      "speaker": "고스트",
      "text": "그러니 당신의 직감을 믿으세요. 그럼 집으로 무사히 돌아갈 수 있을 거예요.",
      "english": "So, trust your instincts, and we'll find a way home.",
      "ticks": 112,
      "duration_sec": 5.591,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F5E.wav",
      "source_sha256": "588e9f879d8237a86c393740505b7790bfab0c97ff71a7bbc2a6a5a69dec7a42",
      "output_sha256": "9f1d10cdf22da3b5271b7b506e2d311777cb4bcbcedc83a72dd7fc2e2ffaf182",
      "output_bytes": 63189
    },
    "80b75f5d": {
      "speaker": "고스트",
      "text": "몰락자가 추적을 시작했어요. 어서 가요.",
      "english": "The Fallen are on the hunt. Let's move.",
      "ticks": 66,
      "duration_sec": 3.2795,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F5D.wav",
      "source_sha256": "28594cd7846585d9d146d8eb834dd7f2dc75c7785cc622ee83fc7d6991ed6dd0",
      "output_sha256": "033f3db0b4d68587268453537dab7ddf76711ea263d16234ad7ad0a509258e68",
      "output_bytes": 39471
    },
    "80b75f5c": {
      "speaker": "고스트",
      "text": "당신의 빛은 강해요, 수호자.",
      "english": "Your Light is strong, Guardian.",
      "ticks": 67,
      "duration_sec": 3.3188,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F5C.wav",
      "source_sha256": "717e1c48c8aa0b15355940cd08f5a7e406bab9dbd140fdcdb1850d1b71b7ffb3",
      "output_sha256": "947fb7a11d301086c3d910d6774344bf15bda662a4643d61aefedfeb2ab724d9",
      "output_bytes": 38673
    },
    "80b75f63": {
      "speaker": "고스트",
      "text": "해적 얘기가 나와서 말인데요…",
      "english": "Speaking of pirates…",
      "ticks": 50,
      "duration_sec": 2.485,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F63.wav",
      "source_sha256": "45559c2555c3ba542e7bc9e45cf0319f9527bf9151fd832806d6a011078e84b7",
      "output_sha256": "160b94ee8b81f74b05a663a917e1cdca717fabf6bd8b28393ea0d9775862d2c9",
      "output_bytes": 30924
    },
    "80b75f67": {
      "speaker": "고스트",
      "text": "저기 은닉품이 있어요. 안에 든 걸 챙겨 가죠.",
      "english": "There's a loot cache. Let's take what's inside.",
      "ticks": 83,
      "duration_sec": 4.1493,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F67.wav",
      "source_sha256": "66ef1922eeb73528001ad4e35b9b735d460b3e56905323fe47a88e5c56bf642f",
      "output_sha256": "f0d9ab2ccc0a03564aebf2cf2e8e1d99c8baada5f573d9ffa24fa4a8fd430884",
      "output_bytes": 49363
    },
    "80b75f62": {
      "speaker": "고스트",
      "text": "싸우러 온 것 같으니, 제대로 맞이해 줘야죠.",
      "english": "They came looking for a fight. Give 'em one.",
      "ticks": 75,
      "duration_sec": 3.7117,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F62.wav",
      "source_sha256": "d8a48c6e6aff7e3fb6ad5cbb7196fcaa7e0a22fcb89e8dd46381d532d6d283b2",
      "output_sha256": "096efb899ac7d2bf2dc1016949858b59f5e5afe4b1c99c1b98aaae05b2041522",
      "output_bytes": 44760
    },
    "80b75f65": {
      "speaker": "고스트",
      "text": "몰락자가 더 있어요! 전력을 다해 쓰러뜨리세요!",
      "english": "More Fallen! Hit 'em with everything you've got!",
      "ticks": 93,
      "duration_sec": 4.6349,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F65.wav",
      "source_sha256": "393159b604373d693d58f8ba473bd61e71b3664fcbb2dcdbd0521e3f9ad70d26",
      "output_sha256": "7c9e86b0e8bcfbb0fa9c17845415688ad2e58db04a8c19e78c783d3accb62709",
      "output_bytes": 53237
    },
    "80b75f64": {
      "speaker": "고스트",
      "text": "이곳은 옛 발사 기지예요. 러시아의 우주 공항이죠.",
      "english": "This place is an old Cosmodrome—a Russian spaceport.",
      "ticks": 91,
      "duration_sec": 4.5354,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F64.wav",
      "source_sha256": "a2d55d6ceae783cddfaf48110f91455dfcf0ebf376879a18f1cddbfed12c57f8",
      "output_sha256": "b74c8c36330cfb4c4b9bfda579cab35651ce1c01ce7a13f3cb549f8e1aa28cbe",
      "output_bytes": 50419
    },
    "80b75f60": {
      "speaker": "고스트",
      "text": "지금은 격리되어 있어요. 아주 위험하기도 하고요. 하지만 앞으로 나아가려면 저 벽을 통과해야 해요.",
      "english": "It's quarantined now—and quite dangerous—but our only way forward is through that wall.",
      "ticks": 153,
      "duration_sec": 7.6205,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F60.wav",
      "source_sha256": "de0431274877295c409e0d0e1ba2a13175ac5d1f20d6e10f0b99de4dd33d4e26",
      "output_sha256": "dae66922f0e46ccd685cbc99afa42cccd06b2030b48f7be7d14395df04c9ba29",
      "output_bytes": 83396
    },
    "80b75f61": {
      "speaker": "고스트",
      "text": "정신 똑바로 차리세요. 추적기가 깜박이면 주변에 적이 있다는 뜻이에요.",
      "english": "Stay focused. If your tracker blinks, there's trouble nearby.",
      "ticks": 107,
      "duration_sec": 5.3237,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F61.wav",
      "source_sha256": "c3e7993a408a087146c2ee1b804ea42e35f96583164e106cae1065b847b6a3fe",
      "output_sha256": "9e580a1774d1f26f2067e429ac6c246704aa2bbffe99cd9747c84245b6a99455",
      "output_bytes": 61234
    },
    "80b75f6b": {
      "speaker": "고스트",
      "text": "잘하고 있어요. 몰락자를 집중 공격하세요.",
      "english": "You're doing great. Focus on the Fallen.",
      "ticks": 68,
      "duration_sec": 3.3668,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F6B.wav",
      "source_sha256": "01ffa98f3e43e8c9f28d2bbbc56da4b30a2e6835c42efadc9698ec2cc0636e23",
      "output_sha256": "af20aa0ce49406f3cf9c2c640fcb1ef424885aabf5a780afee2dd70d18f60056",
      "output_bytes": 40475
    },
    "80b75f6f": {
      "speaker": "고스트",
      "text": "산탄총이네요! 제대로 피해를 줄 수 있겠어요.",
      "english": "A Shotgun! That'll do some damage.",
      "ticks": 67,
      "duration_sec": 3.3296,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F6F.wav",
      "source_sha256": "92cdaccfceef593a4b607b262d7beb4f6f9a03e78df59a60effe3fae572118a1",
      "output_sha256": "ece2ea23157e2f749ae6a8e36a3f88f5b37af6c36aa0503a93b1eb60e17be7f1",
      "output_bytes": 37478
    },
    "80b75f79": {
      "speaker": "고스트",
      "text": "저 벽을 통과해야 해요.",
      "english": "We need to get through that wall.",
      "ticks": 38,
      "duration_sec": 1.8974,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F79.wav",
      "source_sha256": "cabb9ab7fd37254f5fb146f6a3761b8dd9ad5e61e709bfb730a3cc88a74eb3ba",
      "output_sha256": "903050b3d79ca330ea8e40986d9b096ecd4f6992d5c96329afcd6b749e3c675e",
      "output_bytes": 23593
    },
    "80b75f74": {
      "speaker": "고스트",
      "text": "위험하긴 하지만, 제가 빛을 더 확보할게요.",
      "english": "It's a risk, but I'll get us more light.",
      "ticks": 71,
      "duration_sec": 3.5138,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F74.wav",
      "source_sha256": "60525bd730b6001e5d4f967db2caa2ff7e480c4acba3a8efaf37504d6f4d587d",
      "output_sha256": "a6cfc873618f9d13b5713c94b81bcb9bc0addd1e4a8d0defceefbb7597717a4c",
      "output_bytes": 41684
    },
    "80b75f75": {
      "speaker": "고스트",
      "text": "수호자! 이제 가야 해요!",
      "english": "Guardian, we have to go!",
      "ticks": 57,
      "duration_sec": 2.8444,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F75.wav",
      "source_sha256": "bfcd30be1ffeee9426e616ea041f60a965c227e1d2625bb3365e77391f345e9f",
      "output_sha256": "5f74fc7bea4db0a895d777aed83df2ae82c73fdd0fd7c037cd28d9a4ba06a551",
      "output_bytes": 34736
    },
    "80b75f76": {
      "speaker": "고스트",
      "text": "움직여야 해요, 수호자!",
      "english": "It's time to move, Guardian!",
      "ticks": 35,
      "duration_sec": 1.7123,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F76.wav",
      "source_sha256": "7de2433289325f05d96b2016ab80ac2e8980a64f9e72faf0a920d3154983f929",
      "output_sha256": "71da3903b55b7b303becd599cc568bfa67e81c45a45db4ddeb31ee101f2b37f4",
      "output_bytes": 21608
    },
    "80b75f77": {
      "speaker": "고스트",
      "text": "강화된 군용 시스템, 있음. 너덜너덜해진 녹슨 전선, 있음. 제가 \"이 스위치를 켜면\"… 문제가 터질 거예요.",
      "english": "Hard military system: Check. Frayed wires and rust: Check. When I flip this switch, expect trouble.",
      "ticks": 217,
      "duration_sec": 10.8071,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F77.wav",
      "source_sha256": "87c902f2d5a3e42afe68d6d4f463e0095f17995202ffb82c88f49369c59c4ded",
      "output_sha256": "40b9948534d90783c3e1c0dfeb6a204c3fb6d08346d985cb5e7d3feb0f1c39e2",
      "output_bytes": 117386
    },
    "80b75f7a": {
      "speaker": "고스트",
      "text": "조심해요. 우린 포위됐어요.",
      "english": "Careful. They're all around us.",
      "ticks": 56,
      "duration_sec": 2.7654,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F7A.wav",
      "source_sha256": "3a73bd4981a6e8571db0b7e2adae6693444aa539299b967b6cd8ed8b5fc6df1c",
      "output_sha256": "24560fb041cd9fc4b9569e4d1890625c056c7a614883f3e011c0e91ee011faf8",
      "output_bytes": 32950
    },
    "80b75f80": {
      "speaker": "고스트",
      "text": "몰락자는 청소부예요. 인류가 남긴 잔해를 뒤적거리는 외계 해적이죠.",
      "english": "The Fallen are Scavengers—alien pirates picking at humanity's remains.",
      "ticks": 153,
      "duration_sec": 7.6078,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F80.wav",
      "source_sha256": "99e440e37a721ca3317cb2e3540d2127ded1bea08fa45fe1300f8de37fc1c837",
      "output_sha256": "9c49b50237573f3c4de89bfd01c707294326bbded12037544744f8c766b009be",
      "output_bytes": 86347
    },
    "80b75f78": {
      "speaker": "고스트",
      "text": "좋지 않네요! 좋지 않아요! 우리가 반갑지 않은가 봐요.",
      "english": "Not good! Not good! They're definitely not happy to see us.",
      "ticks": 99,
      "duration_sec": 4.9025,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F78.wav",
      "source_sha256": "d057325ca508b1357db283b039b796974c7539bae4b57a7779fb68f3442f9640",
      "output_sha256": "445d6fbdc54701c5243258a826b1b13471c0b8e21e4339877c898edc6d6a1d74",
      "output_bytes": 56837
    },
    "80b75f7b": {
      "speaker": "고스트",
      "text": "조심해요!",
      "english": "Heads up!",
      "ticks": 31,
      "duration_sec": 1.5305,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F7B.wav",
      "source_sha256": "46c3b6892d4902f110fa90604ea8f8440796b456407dbda93d5159639824e072",
      "output_sha256": "fc26531c5c57b1606eaad8b3c6350d272a83b0b32c21d5c401f0ccbf83446a12",
      "output_bytes": 21492
    },
    "80b75f81": {
      "speaker": "고스트",
      "text": "몰락자 습격대에요! 생각했던 것보다 문제가 심각하네요.",
      "english": "A Fallen raiding party! We're in more trouble than I thought.",
      "ticks": 101,
      "duration_sec": 5.0456,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F81.wav",
      "source_sha256": "04a1d37dc99a109404a95eb0e6f667c420132c46e7c5c4d1681d6d3d75db25ef",
      "output_sha256": "11735925599ee142a666f2dd93ec48b75cbc61f0be5d84b0f531c1dbc4300e96",
      "output_bytes": 57280
    },
    "80b75f7f": {
      "speaker": "고스트",
      "text": "조심해요! 보행 탱크에요!",
      "english": "Look out! They're dropping a Walker!",
      "ticks": 43,
      "duration_sec": 2.1272,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F7F.wav",
      "source_sha256": "3fc538235b8fcd2b33d71a2a75fdfc93775250ca990dd4c3f706dce548d8d107",
      "output_sha256": "fddbdce5023b3c45bc5bf21f3f2c7bfbabb35a0ca50f71d02d9c84f6c4df38d6",
      "output_bytes": 27095
    },
    "80b75f7c": {
      "speaker": "고스트",
      "text": "당신을 도시로 데려가야 해요. 그러려면 우주선이 필요해요.",
      "english": "I need to get you back to the City. To do that, we'll need a ship.",
      "ticks": 98,
      "duration_sec": 4.8906,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F7C.wav",
      "source_sha256": "814600ff3eb25f520c3321ccfc39b85247b79056a41e7a80c38f1541fd3eb78b",
      "output_sha256": "9a65618915406175088db01e680162c7173d0336582f17efb088f40184f26263",
      "output_bytes": 55848
    },
    "80b75f7d": {
      "speaker": "고스트",
      "text": "하지만 먼저… 무기부터 찾아야겠어요. 계속 움직여요.",
      "english": "But first, I need to find you a weapon. Let's keep moving.",
      "ticks": 100,
      "duration_sec": 4.995,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F7D.wav",
      "source_sha256": "0a5d0a6ef14ae0b43eddb7008931f9600866679acb769c72a0d5477ecee9a3f5",
      "output_sha256": "6fbadb4d67245683635c3027356f69d84c2c1d93790e99982f093d11a98c099e",
      "output_bytes": 56547
    },
    "80b75f85": {
      "speaker": "고스트",
      "text": "계속 밀어붙이세요.",
      "english": "Keep pushing forward.",
      "ticks": 36,
      "duration_sec": 1.7747,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F85.wav",
      "source_sha256": "bf5d1673a4f725933d6a883f07cb106b469f4201860d7e491a72bd97cd39c177",
      "output_sha256": "51baffb433522d95ea944b21529eec76020b896c0d8ce6fa4235450e1b379c66",
      "output_bytes": 23068
    },
    "80b75f82": {
      "speaker": "고스트",
      "text": "집에 갈 수 있게 우주선을 찾아볼게요.",
      "english": "I'll locate a ship we can use to fly home.",
      "ticks": 61,
      "duration_sec": 3.036,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F82.wav",
      "source_sha256": "a824ed50ef6754f813638c61dc7ed0299b65da83850d6ba424548786c8e417d8",
      "output_sha256": "12e1466e4d83ff77ec5a9e28bb95f9c61c0de7bb04a5b51b751db488be26730b",
      "output_bytes": 35028
    },
    "80b75f84": {
      "speaker": "고스트",
      "text": "모든 게 녹슬고 허물어진 폐허처럼 보이겠죠. 하지만 여길 빠져나가면 상상할 수 없는 경이를 보게 될 거예요.",
      "english": "Everything looks like rust and ruin, but if we can get out of here, you'll see wonders you can't imagine.",
      "ticks": 173,
      "duration_sec": 8.6151,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F84.wav",
      "source_sha256": "bcfebc47f5bc838519acbbb619323f7e9300dc24be8394631cc7e1e7013268a6",
      "output_sha256": "0a1b6ea50f7aa8f293c87ef2620f2d766ae04aab94e65ed237334b5acee2b0a6",
      "output_bytes": 89768
    },
    "80b75f83": {
      "speaker": "고스트",
      "text": "사람들은 수백 년 전에 세계의 종말을 피해 여기로 왔어요. 대부분 살아남지 못했죠.",
      "english": "Hundreds of years ago people came here to escape the end of the world. Most didn't make it.",
      "ticks": 143,
      "duration_sec": 7.1012,
      "voice": true,
      "authored": false,
      "source": "audio/voice_ko/80B75F83.wav",
      "source_sha256": "1b564fd4142d128b23dd117a53b283548d82d436e00ba3cab823a9635666bbae",
      "output_sha256": "4120be10239083412a3932ec4f2ec79967f785b2d1cc34eef2ada6c807fe8afe",
      "output_bytes": 73674
    },
    "rg.opening.found": {
      "speaker": "고스트",
      "text": "…찾았어요. 드디어.",
      "ticks": 53,
      "voice": false,
      "authored": true,
      "note": "Original W300 subtitle-only line. Not in the extraction; no voice recorded or substituted."
    },
    "rg.opening.scan": {
      "speaker": "고스트",
      "text": "움직이지 마세요. 당신의 빛을 되돌려 놓을게요.",
      "ticks": 84,
      "voice": false,
      "authored": true,
      "note": "Original W300 subtitle-only line. Not in the extraction; no voice recorded or substituted."
    },
    "rg.arrival.tower": {
      "speaker": "고스트",
      "text": "도착했어요, 수호자. 여기가 탑이에요.",
      "ticks": 75,
      "voice": false,
      "authored": true,
      "note": "Original W300 subtitle-only line. Not in the extraction; no voice recorded or substituted."
    },
    "rg.walker.legs": {
      "speaker": "고스트",
      "text": "다리를 노려요! 다리 장갑을 부숴야 해요.",
      "ticks": 73,
      "voice": false,
      "authored": true,
      "note": "Original W300 r4 Walker-fight callout (subtitle-only). Not in the extraction; no voice recorded or substituted."
    },
    "rg.walker.leg_broken": {
      "speaker": "고스트",
      "text": "다리가 부서졌어요! 쓰러졌어요!",
      "ticks": 65,
      "voice": false,
      "authored": true,
      "note": "Original W300 r4 Walker-fight callout (subtitle-only). Not in the extraction; no voice recorded or substituted."
    },
    "rg.walker.exposed": {
      "speaker": "고스트",
      "text": "약점이 드러났어요! 주황색 코어를 쏴요!",
      "ticks": 73,
      "voice": false,
      "authored": true,
      "note": "Original W300 r4 Walker-fight callout (subtitle-only). Not in the extraction; no voice recorded or substituted."
    },
    "rg.walker.recover": {
      "speaker": "고스트",
      "text": "다시 일어나요, 다리를 계속 공격해요!",
      "ticks": 70,
      "voice": false,
      "authored": true,
      "note": "Original W300 r4 Walker-fight callout (subtitle-only). Not in the extraction; no voice recorded or substituted."
    },
    "rg.walker.down": {
      "speaker": "고스트",
      "text": "해냈어요! 워커가 쓰러졌어요!",
      "ticks": 62,
      "voice": false,
      "authored": true,
      "note": "Original W300 r4 Walker-fight callout (subtitle-only). Not in the extraction; no voice recorded or substituted."
    },
    "rg.opening.who": {
      "speaker": "고스트",
      "text": "당신은… 누구입니까?",
      "ticks": 44,
      "voice": false,
      "authored": true,
      "note": "Original W300 subtitle-only line (class choice during the opening scan). No voice recorded or substituted."
    },
    "80b779ee": {
      "speaker": "고스트",
      "text": "수호자… 수호자? 눈을 뜨세요, 수호자!",
      "english": "Guardian… Guardian? Eyes up Guardian!",
      "ticks": 91,
      "duration_sec": 4.5077,
      "voice": true,
      "authored": false,
      "source": "Rising-Guardian-Ghost-Opening-KO-2026-11-02/ogg/01_c104b_rfp_0005_gho_80B779EE.ogg (c104b_rfp_0005_gho, w64_sr_dialog_01bb_ko_1.pkg)",
      "source_sha256": "09fd9a315da19f9f91d57150a04f5d27822cf7a4674ddb457eb0af895ec5c67e",
      "output_sha256": "051a72684e22c566508153c859db237d84ff8694504631f0bb7b879e70b0a69f",
      "output_bytes": 54217
    },
    "80b779ef": {
      "speaker": "고스트",
      "text": "성공이야… 깨어나셨네요!",
      "english": "It worked... You’re alive!",
      "ticks": 75,
      "duration_sec": 3.7068,
      "voice": true,
      "authored": false,
      "source": "Rising-Guardian-Ghost-Opening-KO-2026-11-02/ogg/02_c104b_rfp_0010_gho_80B779EF.ogg (c104b_rfp_0010_gho, w64_sr_dialog_01bb_ko_1.pkg)",
      "source_sha256": "f0a3e93c8e9869a9a21e5893a1c1ff6c95877908593646549d721845dacd161d",
      "output_sha256": "dc0a802340db1654212f3d345f5a93057b586f7971a6857968749a43cf100b16",
      "output_bytes": 64351
    },
    "80b779e7": {
      "speaker": "고스트",
      "text": "정말 오랫동안 당신을 찾아 헤맸어요.",
      "english": "You don't know how long I've been looking for you.",
      "ticks": 62,
      "duration_sec": 3.0667,
      "voice": true,
      "authored": false,
      "source": "Rising-Guardian-Ghost-Opening-KO-2026-11-02/ogg/03_c104b_rfp_0020_gho_80B779E7.ogg (c104b_rfp_0020_gho, w64_sr_dialog_01bb_ko_1.pkg)",
      "source_sha256": "10752582fc79499f807da7f220c5fe0e4681c3de7afbf8a9ae33be83e52fc028",
      "output_sha256": "6e8fffab299557057ef58c91cec6fbfe70e699eef1693f8e68973a4feaccf700",
      "output_bytes": 47896
    },
    "80b779ec": {
      "speaker": "고스트",
      "text": "전 고스트예요. 아니, 이젠 당신의 고스트예요. 당신은… 오랫동안 죽어 있었어요. 아마 지금 상황이 이해가 안 될 거예요.",
      "english": "I'm a Ghost. Actually, now I'm your Ghost. And you... Well, you've been dead a long time. So, you're going to see a lot of things you won't understand.",
      "ticks": 222,
      "duration_sec": 11.0667,
      "voice": true,
      "authored": false,
      "source": "Rising-Guardian-Ghost-Opening-KO-2026-11-02/ogg/04_c104b_rfp_0030_gho_80B779EC.ogg (c104b_rfp_0030_gho, w64_sr_dialog_01bb_ko_1.pkg)",
      "source_sha256": "bce247af14e4434645306683d95505125c9b4e0edddcafbdcd50a0fe143e55a7",
      "output_sha256": "567a98c780acb8aceef17912a6f758533a94d14454ea6ca6c2e743e58fb06246",
      "output_bytes": 154747
    },
    "80b779ea": {
      "speaker": "고스트",
      "text": "여긴 몰락자의 영역이에요. 여긴 위험해요.",
      "english": "This is Fallen territory. We aren’t safe here.",
      "ticks": 65,
      "duration_sec": 3.2057,
      "voice": true,
      "authored": false,
      "source": "Rising-Guardian-Ghost-Opening-KO-2026-11-02/ogg/05_c104b_rfp_0040_gho_80B779EA.ogg (c104b_rfp_0040_gho, w64_sr_dialog_01bb_ko_1.pkg)",
      "source_sha256": "dec8031a8c607d780f44cd0cbe57a38e807cb16f253db2e56df357776fd7aa62",
      "output_sha256": "d4a45f36deb7c12b2010671ba842ce59853505b4686a589cd801f24464d6f8cf",
      "output_bytes": 48720
    },
    "80b779eb": {
      "speaker": "고스트",
      "text": "당신을 도시로 데려가야 해요.",
      "english": "I have to get you to the City.",
      "ticks": 57,
      "duration_sec": 2.8239,
      "voice": true,
      "authored": false,
      "source": "Rising-Guardian-Ghost-Opening-KO-2026-11-02/ogg/06_c104b_rfp_0050_gho_80B779EB.ogg (c104b_rfp_0050_gho, w64_sr_dialog_01bb_ko_1.pkg)",
      "source_sha256": "83644f5034ad1e032f10358a128c1342f332440cf11f4b09d49703fdc79cc161",
      "output_sha256": "d51243199a3bd196b7d405e2ed5924b3f35f830660240c955fb3df62f412f9e1",
      "output_bytes": 44653
    },
    "80b779f0": {
      "speaker": "고스트",
      "text": "가만히 있어요.",
      "english": "Hold still.",
      "ticks": 45,
      "duration_sec": 2.2142,
      "voice": true,
      "authored": false,
      "source": "Rising-Guardian-Ghost-Opening-KO-2026-11-02/ogg/07_c104b_rfp_0060_gho_80B779F0.ogg (c104b_rfp_0060_gho, w64_sr_dialog_01bb_ko_1.pkg)",
      "source_sha256": "e80c2f907f068196baec9ae22dce83ecb8bc64e2c58d2302a4acd06f21907176",
      "output_sha256": "23f430e90be774f2ae1a00e792efb3369a753dfb91a93281452c50396b32601e",
      "output_bytes": 33341
    },
    "80b779e9": {
      "speaker": "고스트",
      "text": "사라진 거 아니니까 걱정하지 마세요. 이제 움직여야 해요.",
      "english": "Don't worry, I'm still with you. We need to move, fast.",
      "ticks": 85,
      "duration_sec": 4.2464,
      "voice": true,
      "authored": false,
      "source": "Rising-Guardian-Ghost-Opening-KO-2026-11-02/ogg/08_c104b_rfp_0070_gho_80B779E9.ogg (c104b_rfp_0070_gho, w64_sr_dialog_01bb_ko_1.pkg)",
      "source_sha256": "f9775ecf02c41d64731bb1795e3bc30eaa1b9a1e95e3a7c57414e24cd44df6aa",
      "output_sha256": "28a95e0939d8aba7eecb38bb0d0824d4020f9948b53b0a00e868a56e6e4860c0",
      "output_bytes": 62650
    }
