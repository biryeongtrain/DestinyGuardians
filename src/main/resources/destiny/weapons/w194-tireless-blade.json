    "rawHTML": "<tr style=\"height: 89px\"><th id=\"1662574278R229\" style=\"height: 89px;\"><div style=\"line-height: 89px\">230</div></th><td class=\"s17\">Tireless Blade</td><td class=\"s21\"><div style=\"width:70px;height:89px;\"><img src=\"https://docs.google.com/sheets-images-rt/AO43MLZfu0GGl-8cz2A5r3hUt3LJsxNf4HR5YWPWl8x3IWuSqJ1A47QbDX9LwwR8b2nisZ59ioY1Fua7tjT55_MMlkV6dyTLLlcy8n43Qxi2FybBbmuOws20diUK0_RobG5sgUEDGHemOtEMv_mK1Z-WbASzdZSDCSkEqQ=w70-h89\" title=\"Image\" style=\"width:inherit;height:inherit;object-fit:scale-down;object-position:center center;pointer-events:none;\"/></div></td><td class=\"s19\" colspan=\"4\"><span style=\"font-weight:normal;font-style:italic;\">Upon scoring</span><span style=\"font-style:italic;\"> 2 Powered Sword Kills</span><span style=\"font-weight:normal;font-style:italic;\">:<br></span>Generate +1 Ammo <span style=\"color:#ffd966;\">↑with a ?% chance of granting +2 Ammo</span>.<br><span style=\"font-weight:normal;font-style:italic;\">The first kill upon spawning will trigger the buff. Counter persists through stow.</span><br><br><span style=\"color:#ffd966;\">↑?% Chance to grant +2 Ammo instead of +1 Ammo.</span></td></tr>",
