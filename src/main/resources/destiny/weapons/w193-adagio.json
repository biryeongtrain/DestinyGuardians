      "html": "<tr style=\"height: 89px\"><th id=\"1662574278R6\" style=\"height: 89px;\"><div style=\"line-height: 89px\">7</div></th><td class=\"s14\">Adagio</td><td class=\"s15\"><div style=\"width:70px;height:89px;\"><img src=\"https://lh3.googleusercontent.com/docsubipk/AP9E6xU2kl3fHt0Cv_UFO9CyouS3HG4088Bnl9tHPkBeatbVjUzsIe1m8rn8X-EMDjJy60BgtdvYO9sJyzJQ3Z-R3cRmgrJewCCDr8F455Zy7qnodXpJp-83UzAMlMBpANW_s-LMYnUUnS2hWgXFXZ0SEldNZZcXwpgRPlpTBb8=s89-w70-h89\" style=\"width:inherit;height:inherit;object-fit:scale-down;object-position:center center;pointer-events:none;\"/></div></td><td class=\"s16\" colspan=\"4\"><span style=\"font-weight:normal;font-style:italic;\">On </span><span style=\"font-style:italic;\">Weapon Kill</span><span style=\"font-weight:normal;font-style:italic;\">:<br></span>30% (27% Hand Cannons) increased damage, +10 Range, and 1.2x Fire Recovery Delay/Charge Time Multiplier/Draw Time Multiplier for 7 <span style=\"color:#ffd966;\">↑8</span> seconds.<span style=\"font-size:7pt;\"><br></span><span style=\"font-weight:normal;font-style:italic;\">Buff is removed on stow.</span></td></tr>",
