    "rawRow": "<tr style=\"height: 89px\"><th id=\"1662574278R47\" style=\"height: 89px;\"><div style=\"line-height: 89px\">48</div></th><td class=\"s17\">Clown Cartridge</td><td class=\"s25\"><div style=\"width:70px;height:89px;\"><img src=\"https://docs.google.com/sheets-images-rt/AO43MLaOek5iVV4rVr2hOKnP-w2Puf_QdPdPnMvl_wTPxnQ7gnM1P6ENdT4XYiT7LTkMkRozHFow76Ur46pCUE8S3ulQg1VGXTI2AgKcTVQh4ZPEbIuscvDxDWkZE-I4kw4FWhOS1yUfZb0ccjYir2SJhufdbR0fCVBrMA=w70-h89\" style=\"width:inherit;height:inherit;object-fit:scale-down;object-position:center center;pointer-events:none;\"/></div></td><td class=\"s19\" colspan=\"4\"><span style=\"font-weight:normal;font-style:italic;\">Upon </span><span style=\"font-style:italic;\">finishing a reload</span><span style=\"font-weight:normal;font-style:italic;\">:<br></span>Randomly grants between 10% <span style=\"color:#ffd966;\">↑13%</span> to 50% Increased Magazine Capacity. <span style=\"font-weight:normal;font-style:italic;\">Always rounds up.<br></span>Averages out to 30% <span style=\"color:#ffd966;\">↑31.5%</span> Increased Magazine Capacity.</td></tr>",
