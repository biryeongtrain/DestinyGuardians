      "1449897496": {
        "hash": 1449897496,
        "name": "Adamantine Brace",
        "itemHash": 691578978,
        "itemName": "Oathkeeper",
        "lastUpload": 1766530840776,
        "type": "Armor Trait Exotic",
        "uploadedBy": "Stardust",
        "descriptions": {
          "en": [
            {
              "linesContent": [
                {
                  "text": "Passively grants 40 Airborne Effectiveness and 10 Draw Time Stat (equivalent of a Draw Time Masterwork) to Bows."
                }
              ]
            },
            {
              "classNames": [
                "spacer"
              ]
            },
            {
              "linesContent": [
                {
                  "text": "Full Draws grant 'Adamantine Brace':"
                }
              ]
            },
            {
              "linesContent": [
                {
                  "text": "• Allows Perfect Draws to be held indefinitely"
                }
              ]
            },
            {
              "linesContent": [
                {
                  "text": "• "
                },
                {
                  "text": "Grants 37.5% increased damage against PVE Combatants for every 0.5 seconds you hold a perfect draw, up to a 200% increase",
                  "classNames": [
                    "pve"
                  ]
                }
              ]
            },
            {
              "classNames": [
                "spacer"
              ]
            },
            {
              "linesContent": [
                {
                  "text": "PVE damage buff only affects the initial Impact damage (e.g. Wish Ender's overpenetration is unaffected) and expires after 4 seconds of Adamantine Brace being active."
                }
              ]
            },
            {
              "classNames": [
                "spacer"
              ]
            },
            {
              "linesContent": [
                {
                  "text": "Leviathan's Breath",
                  "classNames": [
                    "yellow"
                  ]
                },
                {
                  "text": " does not receive the damage increase."
                }
              ]
            }
          ]
        }
      }
