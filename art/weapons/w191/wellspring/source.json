  "ddc": {
    "url": "https://docs.google.com/spreadsheets/d/1WaxvbLx7UoSZaBqdFr1u32F2uWVLo-CJunJB4nlGUE4/htmlview/sheet?gid=1662574278",
    "row": 247,
    "nameCellExactMatch": "Wellspring",
    "text": "247   Wellspring        On   Weapon Kill  :  Grants 8%  ↑9%  Ability Energy split equally amongst all uncharged abilities.  On Abilities with multiple charges, once the ability has at least one full charge it will count as charged and will only receive a third of the regular Ability Energy per kill.",
    "html": "<tr style=\"height: 89px\"><th id=\"1662574278R246\" style=\"height: 89px;\"><div style=\"line-height: 89px\">247</div></th><td class=\"s14\">Wellspring</td><td class=\"s26\"><div style=\"width:70px;height:89px;\"><img src=\"https://docs.google.com/sheets-images-rt/AO43MLYC7Ks542ZWRUBgGBN5hytb2ffy3fMRZRaBxCnEd0kbXm2cUO-88siMY1SzIBZs0QrCIDVeYVdl_GGWPK33lAirbM2EueqF7TGYQ79h_C6s_Db_VggLV1bcJCI-Q5KJhsnc3B2WasgX05CmupgZE380r9zKypPEbndh=w70-h89\" style=\"width:inherit;height:inherit;object-fit:scale-down;object-position:center center;pointer-events:none;\"/></div></td><td class=\"s16\" colspan=\"4\"><span style=\"font-weight:normal;font-style:italic;\">On </span><span style=\"font-style:italic;\">Weapon Kill</span><span style=\"font-weight:normal;font-style:italic;\">:<br></span>Grants 8% <span style=\"color:#ffd966;\">↑9%</span> Ability Energy split equally amongst all uncharged abilities.<br><span style=\"font-weight:normal;font-style:italic;\">On Abilities with multiple charges, once the ability has at least one full charge it will count as charged and will only receive a third of the regular Ability Energy per kill.</span></td></tr>"
  },
  "enhancedExcluded": true,
  "mapping": "Single charge only. Valid registered equipped matching-class GRENADE/MELEE/CLASS_ABILITY with remaining>0 and fullCooldown>0; split 8% by initial eligible count, ceil full authored cooldown once after split, clamp remaining to zero; no redistribution, SUPER/JUMP, or multi-charge model."
