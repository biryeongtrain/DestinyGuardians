    "statSource": "Official selected W40 Reload Speed 4188031367",
    "curveSource": "W46 cached oracle_engine weapon_formulas.json, verified against stat_calc.rs and rs_types.rs",
    "bowBoundary": "No selected Outlaw bow. Do not confuse effective stat cap100 with Oracle bow curve clamp85 or its special scalar formula.",
    "precision": "Evaluate unrounded seconds at modified stat, apply0.9, ceil once. Multiplying old integer ticks by0.9 ignores +70 and is invalid.",
    "currentness": "This is the current W62 contract using pinned historical W46 approximations, not a current live Destiny sandbox certification."
  },
  "snapshot": {
    "verifiedDestinyBehavior": false,
    "policy": "Snapshot phase durations at reload start. Each new timed reload can use Outlaw while the buff is active; an already-started phase keeps its captured deadline.",
    "boundary": "Authored integration policy. Retrieved sources do not establish mid-animation expiration, activation during reload, or per-shell re-evaluation; do not infer these from the six-second buff duration."
  },
  "limitations": [
    "No live gameplay tests or exhaustive later-patch audit.",
    "Pool availability is optional-roll eligibility, not automatic equipment.",
    "No enhanced, catalyst, same-name reissue, exotic or sword inferred.",
    "No armor, magazine, masterwork, other perks, frame-specific extra scalar or empty-mag modifier simulated.",
    "No verified exact first-shell delay, animation snapshot, tick endpoint or mixed-pellet classification."
