    "4049631843": {
      "hash": 4049631843,
      "name": "One for All",
      "lastUpload": 1783446631691,
      "type": "Weapon Trait",
      "uploadedBy": "Hawkmoona",
      "descriptions": {
        "en": [
          {
            "linesContent": [
              {
                "text": "Scoring Weapon Hits against 3 Separate Enemies within 3 seconds of each grants 35% increased damage for 10 seconds. Does not require Direct Hits."
              }
            ]
          },
          {
            "classNames": [
              "spacer"
            ]
          },
          {
            "linesContent": [
              {
                "text": "Buff duration cannot be refreshed."
              }
            ]
          }
        ]
      }
    },
    "3708227201": {
      "hash": 3708227201,
      "name": "Surrounded",
      "lastUpload": 1723480728683,
      "type": "Weapon Trait",
      "uploadedBy": "Stardust",
      "descriptions": {
        "en": [
          {
            "linesContent": [
              {
                "text": "Being within 15 meters of 3 Enemies grants 40% increased damage. Buff lingers for 1.5 seconds once the condition is no longer met."
              }
            ]
          },
          {
            "classNames": [
              "spacer"
            ]
          },
          {
            "linesContent": [
              {
                "text": "Exceptions:"
              }
            ]
          },
          {
            "linesContent": [
              {
                "text": "• Swords only receive a 35% damage increase."
              }
            ]
          },
          {
            "linesContent": [
              {
                "text": "• Grenade and Rocket Launchers receive a 35% Explosive Damage increase and a 40% Impact Damage increase."
              }
            ]
          },
          {
            "linesContent": [
              {
                "text": "• Wolfpack Rounds receive a 35% Explosive Damage increase."
              }
            ]
          }
        ]
      }
    }
  }
