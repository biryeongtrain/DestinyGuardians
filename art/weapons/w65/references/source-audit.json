  "units": {
    "quadratic": "rs_types.rs:90-98 evaluates evpp*x*x+vpp*x+offset; stat_calc.rs:24-29 multiplies that result by a dimensionless fraction.",
    "reloadResponseTypes": "Both reload_time and ammo_time are plain f64, not Seconds-annotated, at rs_types.rs:149-154.",
    "secondsEvidence": "W46 extractor treats the reload quadratic as seconds and applies ceil(seconds*20); d2_enums.rs:250 names Seconds=f64. Alias alone is not an annotation on ReloadResponse.",
    "frameDistinction": "build.rs:691-703 divides firing burst delays by30. That conversion is not applied to reload coefficients or ammo_percent.",
    "tickAdaptation": "ceil(capturedFullReloadTicks*explicitRatio), after existing full duration capture/quantization; different in general from ceil(rawSeconds*20*ratio)."
  },
  "modifierCaveat": {
