  "ddc": {
    "tab": "Weapon Perks",
    "row": 248,
    "rawHTML": "<tr style=\"height: 89px\"><th id=\"1662574278R247\" style=\"height: 89px;\"><div style=\"line-height: 89px\">248</div></th><td class=\"s17\">Whirlwind Blade</td><td class=\"s21\"><div style=\"width:70px;height:89px;\"><img src=\"https://docs.google.com/sheets-images-rt/AO43MLbSOwb8dqJIksX4zdsKBlEneeU8hm0GF1rzJX-Q8K23wAfBKAvbdR0Tk179uQEx927LB-ZkZeQu8CpVBNzPaJsBsZG4PIkciAR465NGlxq8_La7FJHuQTOZ5ltaSV4_o9BiKmXNInOcxvsP-GME-JZr6RqKoi1WnvgT=w70-h89\" title=\"Image\" style=\"width:inherit;height:inherit;object-fit:scale-down;object-position:center center;pointer-events:none;\"/></div></td><td class=\"s19\" colspan=\"4\"><span style=\"font-weight:normal;font-style:italic;\">On </span><span style=\"font-style:italic;color:#a481e1;\">Powered Sword Hit</span><span style=\"font-weight:normal;font-style:italic;\">:<br></span>3% | 6% | 9% | 12% | 15% | 18% | 21% | 24% | 27% | 30% Increased damage <span style=\"font-weight:normal;\">for </span>3.5 <span style=\"color:#ffd966;\">↑4</span> seconds.<br>Additional Powered Sword Hits refresh the buff duration.<br><span style=\"font-weight:normal;font-style:italic;\">Blocking or stowing removes all stacks.</span></td></tr>",
    "text": "On Powered Sword Hit : 3% | 6% | 9% | 12% | 15% | 18% | 21% | 24% | 27% | 30% Increased damage for 3.5 ↑4 seconds. Additional Powered Sword Hits refresh the buff duration. Blocking or stowing removes all stacks.",
    "url": "https://docs.google.com/spreadsheets/d/1WaxvbLx7UoSZaBqdFr1u32F2uWVLo-CJunJB4nlGUE4/htmlview/sheet?gid=1662574278"
  },
